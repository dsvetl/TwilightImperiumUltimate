@inherits TwilightImperiumBaseComponenet

<button type="button"
        class="faction-icon @(IsSelected ? "selected" : string.Empty)"
        title="@Name"
        aria-label="@Name"
        aria-pressed="@IsSelected"
        @onclick="() => OnClick.InvokeAsync(Faction)">
    <img class="icon @GetBanIconState()"
         src="@GetFactionIconPath()"
         alt="">
</button>
