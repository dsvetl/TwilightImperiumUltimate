@using TwilightImperiumUltimate.Web.Components.Shared.Search

<nav class="main-navigation handel shadow" aria-label="Main navigation">
    <div class="main-navigation-bar">
        <button class="main-navigation-mobile-toggle"
                type="button"
                aria-expanded="@(_mobileOpen ? "true" : "false")"
                aria-controls="main-navigation-items"
                @onclick="ToggleMobile">
            <span aria-hidden="true">&#9776;</span>
            <span>Menu</span>
        </button>

        <div id="main-navigation-items" class="main-navigation-items @(_mobileOpen ? "mobile-open" : null)">
            @foreach (var item in NavigationCatalog.Main)
            {
                <NavigationGroup Item="@item"
                                 Open="@(_openKey == item.Key)"
                                 OnToggle="ToggleGroup"
                                 OnNavigate="CloseAll" />
            }
        </div>

        <button class="main-navigation-search"
                type="button"
                aria-label="Search the site"
                title="Search"
                @onclick="OpenSearch">
            <span aria-hidden="true">&#8981;</span>
        </button>
    </div>
</nav>

<GlobalSearch Open="@_searchOpen" OnClose="CloseSearch" />
